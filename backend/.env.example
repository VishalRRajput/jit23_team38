# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas for production cloud deployment)
# Example: mongodb+srv://admin:YourPassword@cluster0.abcde.mongodb.net/employee_tracking?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/employee_tracking?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_employee_tracking_2026
JWT_EXPIRES_IN=7d

# Frontend Client URL (optional, for explicit CORS)
CLIENT_URL=https://your-frontend.vercel.app
